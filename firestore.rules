rules_version = '2';

// No login was requested for this app (single-admin, open access), so these
// rules allow anyone with the Firestore project config to read/write.
// If you ever put this behind a login (Firebase Auth), tighten this to
// `allow read, write: if request.auth != null;` instead.
service cloud.firestore {
  match /databases/{database}/documents {
    match /{document=**} {
      allow read, write: if true;
    }
  }
}
